---
// The side-decor canvas, plus a tuning panel that only shows up with ?decor in the URL.
// Picks made in the panel are saved in this browser only (and only used while ?decor is on),
// so visitors always see what's in `decor` in site.ts.
import { decor, decorKinds, decorTune } from '../data/site';

const sections = Object.keys(decor);
---

<canvas id="decor" data-config={JSON.stringify(decor)} data-tune={JSON.stringify(decorTune)} aria-hidden="true"
></canvas>

<aside class="panel" id="decor-panel" hidden aria-label="Side decoration options">
  <header>
    <b>side decor</b>
    <button type="button" data-close aria-label="Hide panel">×</button>
  </header>
  <p class="width"></p>
  <label class="slider">
    <span>amount <output data-out="amount"></output></span>
    <input type="range" min="0" max="100" step="5" data-tune="amount" />
  </label>
  <label class="slider">
    <span>motion <output data-out="motion"></output></span>
    <input type="range" min="0" max="100" step="5" data-tune="motion" />
  </label>
  <label class="row all">
    <span>all sections</span>
    <select data-all>
      <option value="">(mixed)</option>
      {decorKinds.map(([k, label]) => <option value={k}>{label}</option>)}
    </select>
  </label>
  {
    sections.map((s) => (
      <label class="row">
        <span>{s}</span>
        <select data-key={s}>
          {decorKinds.map(([k, label]) => (
            <option value={k}>{label}</option>
          ))}
        </select>
      </label>
    ))
  }
  <div class="actions">
    <button type="button" data-copy>copy config</button>
    <button type="button" data-reset>reset</button>
  </div>
  <p class="hint">Saved in this browser only. Paste the copied config over <code>decor</code> and <code>decorTune</code> in site.ts.</p>
</aside>

<style>
  #decor {
    position: fixed;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .panel {
    position: fixed;
    left: 16px;
    bottom: 16px;
    z-index: 120;
    width: 290px;
    padding: 12px 14px 14px;
    border: 1px solid var(--line-2);
    background: rgb(7 19 20 / 0.95);
    backdrop-filter: blur(8px);
    box-shadow: 0 10px 40px rgb(0 0 0 / 0.6);
    font-size: 12px;
    color: var(--text);
  }
  .panel[hidden] {
    display: none;
  }
  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
    color: var(--ink);
  }
  header button {
    border: 0;
    background: none;
    color: var(--muted);
    font: 700 16px var(--mono);
    cursor: pointer;
  }
  .width {
    margin-bottom: 10px;
    color: var(--muted);
  }
  .width.wide {
    color: var(--mint);
  }
  .slider {
    display: block;
    margin-bottom: 8px;
  }
  .slider span {
    display: flex;
    justify-content: space-between;
  }
  .slider output {
    color: var(--mint);
  }
  .slider input {
    width: 100%;
    accent-color: var(--term);
  }
  .row {
    display: grid;
    grid-template-columns: 9ch 1fr;
    align-items: center;
    gap: 8px;
    margin-top: 6px;
  }
  .row.all {
    padding-bottom: 8px;
    border-bottom: 1px dashed var(--line);
    color: var(--pink);
  }
  select {
    width: 100%;
    padding: 4px 6px;
    border: 1px solid var(--line-2);
    background: var(--bg);
    color: var(--ink);
    font: 12px var(--mono);
  }
  .actions {
    display: flex;
    gap: 8px;
    margin-top: 12px;
  }
  .actions button {
    flex: 1;
    padding: 6px;
    border: 1px solid var(--term);
    background: none;
    color: var(--term);
    font: 600 12px var(--mono);
    cursor: pointer;
  }
  .actions button:hover {
    background: var(--term);
    color: var(--bg);
  }
  .hint {
    margin-top: 10px;
    color: var(--muted);
    font-size: 11px;
    line-height: 1.5;
  }
</style>

<script>
  import { startDecor, type Tune } from '../scripts/decor';
  import type { DecorKind } from '../data/site';

  // bumped from 'hacked-decor' so picks saved before the preset changed don't override it
  const KEY = 'hacked-decor-v2';
  const canvas = document.getElementById('decor') as HTMLCanvasElement;
  const base: Record<string, DecorKind> = JSON.parse(canvas.dataset.config!);
  const baseTune: Tune = JSON.parse(canvas.dataset.tune!);
  const tuning = new URLSearchParams(location.search).has('decor');

  let picks: Record<string, DecorKind> = { ...base };
  let tune: Tune = { ...baseTune };
  if (tuning) {
    try {
      const saved = JSON.parse(localStorage.getItem(KEY) || '{}');
      Object.assign(picks, saved.picks);
      Object.assign(tune, saved.tune);
    } catch {}
  }

  const decor = startDecor(canvas, picks, tune);

  if (tuning) {
    const panel = document.getElementById('decor-panel')!;
    const width = panel.querySelector<HTMLElement>('.width')!;
    const all = panel.querySelector<HTMLSelectElement>('[data-all]')!;
    const selects = [...panel.querySelectorAll<HTMLSelectElement>('select[data-key]')];
    const sliders = [...panel.querySelectorAll<HTMLInputElement>('input[data-tune]')];
    panel.hidden = false;

    const save = () => {
      try {
        localStorage.setItem(KEY, JSON.stringify({ picks, tune }));
      } catch {}
    };
    const sync = () => {
      selects.forEach((s) => (s.value = picks[s.dataset.key!]));
      const kinds = new Set(Object.values(picks));
      all.value = kinds.size === 1 ? [...kinds][0] : '';
      sliders.forEach((s) => {
        const k = s.dataset.tune as keyof Tune;
        s.value = String(Math.round(tune[k] * 100));
        panel.querySelector(`[data-out="${k}"]`)!.textContent = `${s.value}%`;
      });
    };

    sliders.forEach((s) =>
      s.addEventListener('input', () => {
        tune = { ...tune, [s.dataset.tune!]: Number(s.value) / 100 };
        decor.setTune(tune);
        save();
        sync();
      }),
    );
    const showWidth = () => {
      const g = decor.gutter();
      const wide = g >= decor.minGutter;
      width.textContent = wide
        ? `margins: ${g}px each side`
        : `margins: ${g}px, too narrow (needs ${decor.minGutter}px). Widen the window or zoom out.`;
      width.classList.toggle('wide', wide);
    };

    selects.forEach((s) =>
      s.addEventListener('change', () => {
        picks[s.dataset.key!] = s.value as DecorKind;
        decor.set(s.dataset.key!, s.value as DecorKind);
        save();
        sync();
      }),
    );
    all.addEventListener('change', () => {
      if (!all.value) return;
      for (const k of Object.keys(picks)) {
        picks[k] = all.value as DecorKind;
        decor.set(k, picks[k]);
      }
      save();
      sync();
    });
    panel.querySelector('[data-reset]')!.addEventListener('click', () => {
      picks = { ...base };
      tune = { ...baseTune };
      Object.entries(picks).forEach(([k, v]) => decor.set(k, v));
      decor.setTune(tune);
      try {
        localStorage.removeItem(KEY);
      } catch {}
      sync();
    });
    const copy = panel.querySelector<HTMLButtonElement>('[data-copy]')!;
    copy.addEventListener('click', async () => {
      const body = Object.entries(picks)
        .map(([k, v]) => `  ${k}: '${v}',`)
        .join('\n');
      const text =
        `export const decor: Record<string, DecorKind> = {\n${body}\n};\n\n` +
        `export const decorTune = { amount: ${tune.amount}, motion: ${tune.motion} };`;
      try {
        await navigator.clipboard.writeText(text);
        copy.textContent = 'copied!';
      } catch {
        prompt('Copy this into site.ts:', text);
      }
      setTimeout(() => (copy.textContent = 'copy config'), 1500);
    });
    panel.querySelector('[data-close]')!.addEventListener('click', () => (panel.hidden = true));

    sync();
    setTimeout(showWidth, 100);
    addEventListener('resize', () => setTimeout(showWidth, 100));
    addEventListener('scroll', () => requestAnimationFrame(showWidth), { passive: true });
  }
</script>
